{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": { "api/*.js": { "maxDuration": 300 } },
  "crons": [{ "path": "/api/maintenance", "schedule": "0 6 * * *" }],
  "git": {
    "deploymentEnabled": {
      "codex/local-first-tres-modulos": false
    }
  }
}
